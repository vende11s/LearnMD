# Optional local overrides: copy this file to .env.local.
# Empty values disable sharing locally; production defaults are in .env.production.
# Public API endpoint and public Turnstile site key; never put secrets here.
VITE_SHARE_API_URL=
VITE_TURNSTILE_SITE_KEY=

# Local development only. Requires a loopback app and API URL, and the
# Worker's own explicit development bypass. Never enabled in production builds.
VITE_SHARE_DEV_BYPASS=false
